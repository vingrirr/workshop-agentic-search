# LLM: any OpenAI-compatible chat endpoint (the workshop uses a LiteLLM gateway).
LITELLM_API_KEY='sk-...'
LITELLM_API_BASE='https://your-gateway/v1'

# Optional model overrides (defaults target the workshop gateway):
# LLM_SMALL_MODEL='llm-gateway/gpt-5.4-nano'
# LLM_MID_MODEL='llm-gateway/gpt-5.4-mini'
# LLM_TEMPERATURE='0.5'

# PostgreSQL datasource (the pgvector extension is needed for semantic search).
DATABASE_URL='postgresql://user:password@localhost:5432/workshop'
# PG_TABLE='conference_schedule'
# EMBEDDING_DIM is auto-detected at index time; set it only to override.
# EMBEDDING_DIM='512'

# Jina embeddings, used by semantic search (technique 01).
# Free key (no registration) at https://jina.ai/api-dashboard/embedding
JINA_API_KEY='jina_...'
# JINA_MODEL='jina-embeddings-v5-text-small'
