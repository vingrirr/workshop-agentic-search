{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Prepare data",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/prepare_data.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false,
      "env": { "PYTHONPATH": "${workspaceFolder}/src" }
    },
    {
      "name": "Prepare data (no embeddings, offline)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/prepare_data.py",
      "args": ["--no-embeddings"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false,
      "env": { "PYTHONPATH": "${workspaceFolder}/src" }
    },
    {
      "name": "01 - Vanilla semantic search",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/run_vanilla_search.py",
      "args": ["--query", "Which sessions discuss regulatory constraints in AI systems?"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false,
      "env": { "PYTHONPATH": "${workspaceFolder}/src" }
    },
    {
      "name": "02 - DB query tool + skill",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/run_db_query.py",
      "args": ["--query", "Which sessions should I visit to learn more about GEPA?"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false,
      "env": { "PYTHONPATH": "${workspaceFolder}/src" }
    },
    {
      "name": "03 - Shell tool",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/run_shell_search.py",
      "args": ["--query", "Which sessions discuss handling regulatory constraints?"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false,
      "env": { "PYTHONPATH": "${workspaceFolder}/src" }
    },
    {
      "name": "03 - Shell tool + jina-grep",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/run_shell_search.py",
      "args": ["--jina", "--query", "Which sessions discuss handling regulatory constraints?"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false,
      "env": { "PYTHONPATH": "${workspaceFolder}/src" }
    },
    {
      "name": "Python: current file",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false,
      "env": { "PYTHONPATH": "${workspaceFolder}/src" }
    }
  ]
}
